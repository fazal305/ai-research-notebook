# Copy this file to .env and fill in real values locally.
# .env is gitignored — never commit real secrets.
#
# This key is used ONLY by the Netlify serverless function at
# netlify/functions/claude-proxy.js, which runs server-side.
# It is never bundled into frontend code or sent to the browser.
ANTHROPIC_API_KEY=

# Model used for cloud analysis requests (see services/ai/cloudAIProvider.js)
ANTHROPIC_MODEL=claude-sonnet-5
